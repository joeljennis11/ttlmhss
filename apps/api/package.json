{
  "name": "@ttlmhss/api",
  "version": "0.1.0",
  "private": true,
  "description": "TTLMHSS API server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@ttlmhss/source src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --conditions=@ttlmhss/source src/scripts/db.ts migrate",
    "db:rollback": "tsx --conditions=@ttlmhss/source src/scripts/db.ts rollback",
    "db:status": "tsx --conditions=@ttlmhss/source src/scripts/db.ts status",
    "db:migrate:prod": "node dist/scripts/db.js migrate",
    "account": "tsx --conditions=@ttlmhss/source src/scripts/accounts.ts",
    "account:prod": "node dist/scripts/accounts.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@node-rs/argon2": "^2.2.1",
    "@ttlmhss/shared": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.16.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  }
}
