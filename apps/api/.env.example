# TTLMHSS API — environment variables
#
# Loading order (first one wins for each variable):
#   1. real environment variables
#   2. apps/api/.env.<NODE_ENV>.local   (git-ignored; your machine-specific overrides and secrets)
#   3. apps/api/.env.<NODE_ENV>         (committed defaults for development/test; NO secrets)
#   4. apps/api/.env                    (git-ignored)
#
# In production, set everything through the real environment. Never commit secrets.

# development | test | production
NODE_ENV=development

HOST=127.0.0.1
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Database connection. The provider is not finalised (docs/decisions.md D-04).
# Supported adapters:
#   sqlite:<file path>      e.g. sqlite:./data/ttlmhss.dev.sqlite   (relative to apps/api)
#   sqlite::memory:         in-memory, tests only
#   postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:./data/ttlmhss.dev.sqlite

# Comma-separated list of browser origins allowed to call the API: exact origins only
# (scheme://host[:port], no path, no "*"). Production requires https:// origins.
CORS_ORIGINS=http://localhost:5173

# Set to true ONLY when the API runs behind a reverse proxy you control (so the real client IP
# from X-Forwarded-For is used for rate limiting). Default: false.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Authentication (Phase 2)
# ---------------------------------------------------------------------------
# Key used to HMAC session tokens before they are stored. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production also rejects obvious placeholders and repetitive values. Never commit a real value. In development, put it in apps/api/.env.development.local; if it is
# missing in development/test, a random per-process value is used (everyone is signed out on restart).
SESSION_SECRET=

# Sign-out after this many minutes without activity (5–1440). Default 120.
SESSION_IDLE_TIMEOUT_MINUTES=120
# Hard limit on a session's lifetime regardless of activity (1–720 hours). Default 12.
SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# Send the session cookie only over HTTPS (and HSTS). Default: true in production, false otherwise.
# Production refuses to start with COOKIE_SECURE=false (Phase 12A): serve the app over HTTPS.
# COOKIE_SECURE=true

# Sign-in protection:
#   requests per client IP per minute on /auth/login and /auth/change-password
LOGIN_RATE_LIMIT_PER_MINUTE=10
#   failed attempts per username before a temporary lock, and the lock duration
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
