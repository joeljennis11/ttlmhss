{
  "name": "ttlmhss",
  "private": true,
  "description": "TTLMHSS School Management System — Thiruthangal Lions Matriculation Higher Secondary School",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ttlmhss/api --filter @ttlmhss/web dev",
    "dev:api": "pnpm --filter @ttlmhss/api dev",
    "dev:web": "pnpm --filter @ttlmhss/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @ttlmhss/api start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "db:migrate": "pnpm --filter @ttlmhss/api db:migrate",
    "db:rollback": "pnpm --filter @ttlmhss/api db:rollback",
    "db:status": "pnpm --filter @ttlmhss/api db:status",
    "account": "pnpm --filter @ttlmhss/api account",
    "readiness": "pnpm --filter @ttlmhss/api readiness"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
