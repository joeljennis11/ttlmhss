# /etc/ttlmhss/api.env — production environment for the API (Phase 12C). PLACEHOLDERS ONLY.
# Copy to /etc/ttlmhss/api.env, chmod 600, fill in real values there. Never commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# PostgreSQL (recommended for production) or a SQLite file on persistent disk:
#   DATABASE_URL=postgres://ttlmhss:<password>@127.0.0.1:5432/ttlmhss
#   DATABASE_URL=sqlite:/srv/ttlmhss/apps/api/data/ttlmhss.sqlite
DATABASE_URL=
# Exactly the site address (https, no path, no trailing slash):
CORS_ORIGINS=https://school.example
# nginx on the same host forwards requests; the API listens on 127.0.0.1 only:
TRUST_PROXY=true
# 48 random bytes: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_IDLE_TIMEOUT_MINUTES=120
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Sign-in protection (D-121); defaults shown.
LOGIN_RATE_LIMIT_PER_MINUTE=60
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ACCOUNT_MAX_FAILED_ATTEMPTS=20
LOGIN_LOCKOUT_MINUTES=15
# No SMS provider is integrated in this version (D-125):
SMS_PROVIDER=none
